{
  "name": "printobserver-sdk-node-integration",
  "root": "npm/printobserver-sdk/integration",
  "projectType": "library",
  "tags": ["lang:typescript", "type:integration"],
  "implicitDependencies": ["printobserver-sdk-node"],
  "targets": {
    "format": {
      "command": "bunx biome format --write npm/printobserver-sdk/integration"
    },
    "format-check": {
      "command": "bunx biome format npm/printobserver-sdk/integration"
    },
    "lint": {
      "command": "bunx biome lint npm/printobserver-sdk/integration"
    },
    "typecheck": {
      "command": "bunx tsc --noEmit -p npm/printobserver-sdk/tsconfig.json"
    },
    "test-integration": {
      "command": "bun test",
      "options": {
        "cwd": "npm/printobserver-sdk/integration"
      }
    }
  }
}
