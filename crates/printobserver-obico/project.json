{
  "name": "printobserver-obico",
  "root": "crates/printobserver-obico",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "type:implementation"
  ],
  "targets": {
    "format": {
      "command": "cargo fmt -p printobserver-obico"
    },
    "format-check": {
      "command": "cargo fmt -p printobserver-obico -- --check"
    },
    "lint": {
      "command": "cargo clippy -p printobserver-obico --all-targets --locked -- -D warnings"
    },
    "test": {
      "command": "bash -c 'if [ \"${OS:-}\" = Windows_NT ]; then export LLVM_PROFILE_FILE_NAME=printobserver-obico-%p-%m.profraw; fi; exec cargo llvm-cov nextest -p printobserver-obico --no-report --no-tests=pass'"
    },
    "build": {
      "command": "cargo build -p printobserver-obico --locked"
    }
  }
}
