{
  "name": "printobserver-core",
  "root": "crates/printobserver-core",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "type:core"
  ],
  "targets": {
    "format": {
      "command": "cargo fmt -p printobserver-core"
    },
    "format-check": {
      "command": "cargo fmt -p printobserver-core -- --check"
    },
    "lint": {
      "command": "cargo clippy -p printobserver-core --all-targets --locked -- -D warnings"
    },
    "test": {
      "command": "bash -c 'if [ \"${OS:-}\" = Windows_NT ]; then export LLVM_PROFILE_FILE_NAME=printobserver-core-%p-%9m.profraw; fi; exec cargo llvm-cov nextest -p printobserver-core --no-report --no-tests=pass'"
    },
    "build": {
      "command": "cargo build -p printobserver-core --locked"
    }
  }
}
