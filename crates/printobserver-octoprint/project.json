{
  "name": "printobserver-octoprint",
  "root": "crates/printobserver-octoprint",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "type:implementation"
  ],
  "targets": {
    "format": {
      "command": "cargo fmt -p printobserver-octoprint"
    },
    "format-check": {
      "command": "cargo fmt -p printobserver-octoprint -- --check"
    },
    "lint": {
      "command": "cargo clippy -p printobserver-octoprint --all-targets --locked -- -D warnings"
    },
    "typecheck": {
      "command": "cargo check -p printobserver-octoprint --all-targets --locked"
    },
    "test": {
      "command": "cargo llvm-cov nextest -p printobserver-octoprint --no-report --no-tests=pass -E 'not binary(integration)'"
    },
    "build": {
      "command": "cargo build -p printobserver-octoprint --locked"
    },
    "test-integration": {
      "command": "cargo nextest run -p printobserver-octoprint --no-fail-fast -E 'binary(integration)'"
    }
  }
}
