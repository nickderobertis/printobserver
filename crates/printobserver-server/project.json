{
  "name": "printobserver-server",
  "root": "crates/printobserver-server",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "type:composition-root"
  ],
  "targets": {
    "format": {
      "command": "cargo fmt -p printobserver-server"
    },
    "format-check": {
      "command": "cargo fmt -p printobserver-server -- --check"
    },
    "lint": {
      "command": "cargo clippy -p printobserver-server --all-targets --locked -- -D warnings"
    },
    "typecheck": {
      "command": "cargo check -p printobserver-server --all-targets --locked"
    },
    "test": {
      "command": "cargo llvm-cov nextest -p printobserver-server --no-report --no-tests=pass"
    },
    "build": {
      "command": "cargo build -p printobserver-server --locked"
    }
  }
}
