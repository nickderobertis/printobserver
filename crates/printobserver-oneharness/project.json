{
  "name": "printobserver-oneharness",
  "root": "crates/printobserver-oneharness",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "type:implementation"
  ],
  "targets": {
    "format": {
      "command": "cargo fmt -p printobserver-oneharness"
    },
    "format-check": {
      "command": "cargo fmt -p printobserver-oneharness -- --check"
    },
    "lint": {
      "command": "cargo clippy -p printobserver-oneharness --all-targets --features test-responder --locked -- -D warnings"
    },
    "test": {
      "command": "bash -c 'if [ \"${OS:-}\" = Windows_NT ]; then export LLVM_PROFILE_FILE_NAME=printobserver-oneharness-%p.profraw; fi; exec cargo llvm-cov nextest -p printobserver-oneharness --features test-responder --no-report --no-tests=pass'"
    },
    "build": {
      "command": "cargo build -p printobserver-oneharness --locked"
    }
  }
}
