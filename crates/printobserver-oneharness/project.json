{
  "name": "printobserver-oneharness",
  "root": "crates/printobserver-oneharness",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "type:implementation"
  ],
  "targets": {
    "format": {
      "command": "cargo fmt -p printobserver-oneharness"
    },
    "format-check": {
      "command": "cargo fmt -p printobserver-oneharness -- --check"
    },
    "lint": {
      "command": "cargo clippy -p printobserver-oneharness --all-targets --locked -- -D warnings"
    },
    "typecheck": {
      "command": "cargo check -p printobserver-oneharness --all-targets --locked"
    },
    "test": {
      "command": "cargo llvm-cov nextest -p printobserver-oneharness --no-report --no-tests=pass"
    },
    "build": {
      "command": "cargo build -p printobserver-oneharness --locked"
    }
  }
}
