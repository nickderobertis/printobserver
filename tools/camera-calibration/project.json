{
  "name": "camera-calibration",
  "root": "tools/camera-calibration",
  "projectType": "library",
  "tags": [
    "lang:python",
    "type:tooling"
  ],
  "targets": {
    "format": {
      "command": "uv run -q --package=camera-calibration ruff format tools/camera-calibration"
    },
    "format-check": {
      "command": "uv run -q --package=camera-calibration ruff format --check tools/camera-calibration"
    },
    "lint": {
      "command": "uv run -q --package=camera-calibration ruff check tools/camera-calibration"
    },
    "typecheck": {
      "command": "uv run -q --package=camera-calibration ty check --project=tools/camera-calibration tools/camera-calibration && uv run -q --package=camera-calibration ty check --project=tools/camera-calibration --python-platform win32 tools/camera-calibration"
    },
    "test": {
      "command": "uv run -q --package=camera-calibration --directory=tools/camera-calibration pytest tests",
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/tests/real-prints/cameras/**/*",
        "{workspaceRoot}/tests/real-prints/bubbler-colour-change-*/**/*",
        "{workspaceRoot}/tests/real-prints/service-config.toml",
        "{workspaceRoot}/schemas/printobserver-panels/**/*",
        "{workspaceRoot}/crates/printobserver-panels/tests/fixtures/frames/**/*",
        "{workspaceRoot}/crates/printobserver-core/tests/fixtures/real-prints/**/*",
        "{workspaceRoot}/crates/printobserver-server/tests/fixtures/real-prints/**/*"
      ],
      "outputs": ["{projectRoot}/telemetry"]
    },
    "budgets": {
      "command": "bunx onebudgetspec check tools/camera-calibration/budgets.yaml",
      "dependsOn": ["test"],
      "cache": false
    }
  }
}
