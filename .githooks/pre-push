#!/usr/bin/env bash
# Run the whole gate before anything leaves this machine.
#
# Installed by `just bootstrap` (`git config core.hooksPath .githooks`). If it is
# slow, wait for it; if it refuses, it is telling you something about the commit
# in front of you.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
just check
