#!/usr/bin/env bash
# Refuse a commit subject that is not a Conventional Commit.
#
# The admitted types come from `repo-policy.toml` — `commits.release_types`
# (feat, fix, perf) plus `commits.non_release_types` — rather than from a list
# repeated here, so this hook and the release rule cannot disagree. A repository
# whose own hook refuses the subjects its own plan publishes under is a release
# that fails after the work is done.
#
# Installed by `just bootstrap` (`git config core.hooksPath .githooks`).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The packages the checks live in, exactly as the justfile exports them: the
# check registry names the client checks, and those read the generator that
# writes the three clients. Joined with the separator the interpreter on this
# host reads, as the justfile joins them: a Windows interpreter splits a search
# path on `;` and reads a `:`-joined one as a single entry that names nothing.
separator=":"
if [ "${OS:-}" = Windows_NT ]; then
    separator=";"
fi
PYTHONPATH="tools/repo-checks/src${separator}tools/contract-codegen/src${separator}tools/release-artifacts/src" \
    uv run -q python -m repo_checks commit-msg "$1"
