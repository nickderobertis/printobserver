{
  "$defs": {
    "ActionId": {
      "description": "A lowercase hyphenated version 7 UUID identifying one requested action.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "ActionId",
      "type": "string"
    },
    "ActionKind": {
      "description": "One action of the closed vocabulary, named without its payload.\n\nThis is what a safety envelope grants and what a policy rejection names; the\npayload lives on [`PrintAction`] itself.",
      "oneOf": [
        {
          "const": "pause",
          "description": "Pause the print.",
          "type": "string"
        },
        {
          "const": "resume",
          "description": "Resume the print.",
          "type": "string"
        },
        {
          "const": "cancel",
          "description": "Cancel the print.",
          "type": "string"
        },
        {
          "const": "start_print",
          "description": "Start a print of a named file.",
          "type": "string"
        },
        {
          "const": "set_feedrate_factor",
          "description": "Set the feedrate factor.",
          "type": "string"
        },
        {
          "const": "set_flowrate_factor",
          "description": "Set the flowrate factor.",
          "type": "string"
        },
        {
          "const": "set_tool_target_c",
          "description": "Set a tool's target temperature.",
          "type": "string"
        },
        {
          "const": "set_bed_target_c",
          "description": "Set the bed's target temperature.",
          "type": "string"
        },
        {
          "const": "set_fan_percent",
          "description": "Set the fan percentage.",
          "type": "string"
        },
        {
          "const": "acknowledge_failure",
          "description": "Acknowledge a failure event.",
          "type": "string"
        },
        {
          "const": "register_spool",
          "description": "Register a spool.",
          "type": "string"
        },
        {
          "const": "load_spool",
          "description": "Load a spool onto a tool.",
          "type": "string"
        },
        {
          "const": "unload_spool",
          "description": "Unload a spool from its tool.",
          "type": "string"
        },
        {
          "const": "adjust_spool",
          "description": "Correct a spool's remaining figure.",
          "type": "string"
        },
        {
          "const": "retire_spool",
          "description": "Retire a spool.",
          "type": "string"
        }
      ]
    },
    "ActorClass": {
      "description": "An actor class, which is what a safety envelope grants actions to.",
      "oneOf": [
        {
          "const": "agent",
          "description": "The supervising agent.",
          "type": "string"
        },
        {
          "const": "operator",
          "description": "A person.",
          "type": "string"
        },
        {
          "const": "system",
          "description": "The supervisor itself.",
          "type": "string"
        }
      ]
    },
    "Adjustable": {
      "description": "One thing an adjustment may change.",
      "pattern": "^(feedrate|flowrate|bed_target|fan|tool_target:-?[0-9]+)$",
      "title": "Adjustable",
      "type": "string"
    },
    "PolicyDecision": {
      "description": "The decision policy took on one request.",
      "oneOf": [
        {
          "const": "accepted",
          "description": "The request may proceed.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The request may not, for this reason.",
          "properties": {
            "rejected": {
              "$ref": "#/$defs/RejectionReason"
            }
          },
          "required": [
            "rejected"
          ],
          "type": "object"
        }
      ]
    },
    "PrintId": {
      "description": "A lowercase hyphenated version 7 UUID identifying one print.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "PrintId",
      "type": "string"
    },
    "PrinterState": {
      "description": "The state a source reports a printer or a print to be in.\n\nThe `unknown` arm exists so that a state nobody anticipated is recorded\ncarrying the source's own word for it rather than lost.",
      "oneOf": [
        {
          "const": "operational",
          "description": "Connected and idle.",
          "type": "string"
        },
        {
          "const": "paused",
          "description": "Printing, but paused.",
          "type": "string"
        },
        {
          "const": "printing",
          "description": "Printing.",
          "type": "string"
        },
        {
          "const": "cancelling",
          "description": "Cancelling a print.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "In an error state.",
          "type": "string"
        },
        {
          "const": "offline",
          "description": "Not reachable.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A state this vocabulary does not name, in the source's own word for it.",
          "properties": {
            "unknown": {
              "type": "string"
            }
          },
          "required": [
            "unknown"
          ],
          "type": "object"
        }
      ]
    },
    "Range": {
      "additionalProperties": false,
      "description": "An inclusive pair of 64-bit floats.",
      "properties": {
        "max": {
          "description": "The highest value the range admits, inclusive.",
          "format": "double",
          "type": "number"
        },
        "min": {
          "description": "The lowest value the range admits, inclusive.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "RejectionReason": {
      "description": "Why a request was refused.\n\nEach rejection is a distinct variant, so a consumer distinguishes them by\nmatching rather than by reading a message.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The value asked for is outside the range allowed for that adjustable.",
          "properties": {
            "out_of_bounds": {
              "additionalProperties": false,
              "properties": {
                "adjustable": {
                  "$ref": "#/$defs/Adjustable",
                  "description": "The adjustable that was asked for."
                },
                "allowed": {
                  "$ref": "#/$defs/Range",
                  "description": "The range that was allowed."
                },
                "requested": {
                  "description": "The value that was asked for.",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "adjustable",
                "requested",
                "allowed"
              ],
              "type": "object"
            }
          },
          "required": [
            "out_of_bounds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "This actor class may not request this action at all.",
          "properties": {
            "actor_may_not_request": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "$ref": "#/$defs/ActionKind",
                  "description": "The action they asked for."
                },
                "actor_class": {
                  "$ref": "#/$defs/ActorClass",
                  "description": "The class of the actor that asked."
                }
              },
              "required": [
                "actor_class",
                "action"
              ],
              "type": "object"
            }
          },
          "required": [
            "actor_may_not_request"
          ],
          "type": "object"
        },
        {
          "const": "no_active_print",
          "description": "There is no active print to act on.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The printer is not in a state this action is valid from.",
          "properties": {
            "invalid_from_state": {
              "additionalProperties": false,
              "properties": {
                "state": {
                  "$ref": "#/$defs/PrinterState",
                  "description": "The state the printer is in."
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            }
          },
          "required": [
            "invalid_from_state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The agent's minimum interval has not elapsed.",
          "properties": {
            "min_interval_not_elapsed": {
              "additionalProperties": false,
              "properties": {
                "interval_s": {
                  "description": "The minimum interval, in whole seconds.",
                  "format": "int64",
                  "type": "integer"
                },
                "since_last_s": {
                  "description": "How long it has been since the last agent action, in whole seconds.",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "interval_s",
                "since_last_s"
              ],
              "type": "object"
            }
          },
          "required": [
            "min_interval_not_elapsed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The adjustable is not one this printer has.",
          "properties": {
            "unsupported_adjustable": {
              "additionalProperties": false,
              "properties": {
                "adjustable": {
                  "$ref": "#/$defs/Adjustable",
                  "description": "The adjustable this printer cannot express."
                }
              },
              "required": [
                "adjustable"
              ],
              "type": "object"
            }
          },
          "required": [
            "unsupported_adjustable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A start was refused because the spool on one tool holds less than the\nprint needs and its buffer.",
          "properties": {
            "insufficient_filament": {
              "additionalProperties": false,
              "properties": {
                "buffer_g": {
                  "description": "The margin asked for beyond that, in grams.",
                  "format": "double",
                  "type": "number"
                },
                "remaining_g": {
                  "description": "What the spool holds, in grams.",
                  "format": "double",
                  "type": "number"
                },
                "required_g": {
                  "description": "What the print needs from it, in grams.",
                  "format": "double",
                  "type": "number"
                },
                "spool_id": {
                  "$ref": "#/$defs/SpoolId",
                  "description": "The spool loaded on it."
                },
                "spool_name": {
                  "description": "That spool's name.",
                  "type": "string"
                },
                "tool": {
                  "description": "The tool whose spool is short.",
                  "format": "int64",
                  "type": "integer"
                },
                "unverified": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/UnverifiedReason"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The spool's oldest mark, when the short spool is also unverified."
                }
              },
              "required": [
                "tool",
                "spool_id",
                "spool_name",
                "required_g",
                "buffer_g",
                "remaining_g"
              ],
              "type": "object"
            }
          },
          "required": [
            "insufficient_filament"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A start was refused because the spool on one tool is unverified.",
          "properties": {
            "unverified_spool": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "$ref": "#/$defs/UnverifiedReason",
                  "description": "The spool's oldest mark."
                },
                "spool_id": {
                  "$ref": "#/$defs/SpoolId",
                  "description": "The spool loaded on it."
                },
                "spool_name": {
                  "description": "That spool's name.",
                  "type": "string"
                },
                "tool": {
                  "description": "The tool whose spool is unverified.",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "tool",
                "spool_id",
                "spool_name",
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "unverified_spool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A start was refused because `OctoPrint`'s analysis of the file had not\nappeared when the start's wait for it elapsed.",
          "properties": {
            "analysis_unavailable": {
              "additionalProperties": false,
              "properties": {
                "file_name": {
                  "description": "The file that has no analysis.",
                  "type": "string"
                },
                "waited_s": {
                  "description": "How long the start waited for one, in whole seconds.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "file_name",
                "waited_s"
              ],
              "type": "object"
            }
          },
          "required": [
            "analysis_unavailable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A spool command could not be carried out.",
          "properties": {
            "spool_refused": {
              "additionalProperties": false,
              "properties": {
                "cause": {
                  "$ref": "#/$defs/SpoolRefusalCause",
                  "description": "Why, in a form a client acts on without reading `message`."
                },
                "message": {
                  "description": "Why, in a sentence naming what to do instead, for a person.",
                  "type": "string"
                }
              },
              "required": [
                "cause",
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "spool_refused"
          ],
          "type": "object"
        }
      ]
    },
    "SpoolField": {
      "description": "One field of a spool command, as the command names it.",
      "oneOf": [
        {
          "const": "name",
          "description": "The operator's own label for the spool.",
          "type": "string"
        },
        {
          "const": "material",
          "description": "The material, such as `PLA`.",
          "type": "string"
        },
        {
          "const": "diameter_mm",
          "description": "The filament's diameter, in millimetres.",
          "type": "string"
        },
        {
          "const": "density_g_cm3",
          "description": "The material's density, in grams per cubic centimetre.",
          "type": "string"
        },
        {
          "const": "initial_g",
          "description": "The net filament on the spool when full, in grams.",
          "type": "string"
        },
        {
          "const": "remaining_g",
          "description": "The filament on the spool now, in grams.",
          "type": "string"
        },
        {
          "const": "tare_g",
          "description": "The empty spool's own weight, in grams.",
          "type": "string"
        },
        {
          "const": "gross_g",
          "description": "A scale reading of the spool, in grams.",
          "type": "string"
        }
      ]
    },
    "SpoolId": {
      "description": "A lowercase hyphenated version 7 UUID identifying one registered spool.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "SpoolId",
      "type": "string"
    },
    "SpoolRefusalCause": {
      "description": "Why the spool ledger refused a command, each cause carrying what a client\nneeds to choose the next valid request.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "No spool was ever registered under this identifier.",
          "properties": {
            "cause": {
              "const": "unknown_spool",
              "type": "string"
            },
            "spool_id": {
              "$ref": "#/$defs/SpoolId",
              "description": "The identifier the command named."
            }
          },
          "required": [
            "cause",
            "spool_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The spool is retired, and takes no further command.",
          "properties": {
            "cause": {
              "const": "retired_spool",
              "type": "string"
            },
            "spool_id": {
              "$ref": "#/$defs/SpoolId",
              "description": "The retired spool."
            }
          },
          "required": [
            "cause",
            "spool_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The spool named is already on the tool, and nothing is pending there or\nmarked on it for a load to confirm.",
          "properties": {
            "cause": {
              "const": "nothing_to_confirm",
              "type": "string"
            },
            "tool": {
              "description": "The tool the spool is already on.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "cause",
            "tool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A figure the command gave is not one the field can hold: not a number,\nor out of the field's range.",
          "properties": {
            "cause": {
              "const": "invalid_adjustment_figure",
              "type": "string"
            },
            "field": {
              "$ref": "#/$defs/SpoolField",
              "description": "The field the figure was given for."
            },
            "value": {
              "description": "The figure given.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "cause",
            "field",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A scale reading was given for a spool with no tare, so it cannot be\nturned into a figure.",
          "properties": {
            "cause": {
              "const": "tare_required",
              "type": "string"
            },
            "spool_id": {
              "$ref": "#/$defs/SpoolId",
              "description": "The spool with no tare."
            }
          },
          "required": [
            "cause",
            "spool_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The material has no known density, so the command needs one.",
          "properties": {
            "cause": {
              "const": "density_required",
              "type": "string"
            },
            "material": {
              "description": "The material, as given and trimmed.",
              "type": "string"
            },
            "spool_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SpoolId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The spool, when the command was about one that exists; absent for\na registration."
            }
          },
          "required": [
            "cause",
            "material"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A field the command needs was empty or absent.",
          "properties": {
            "cause": {
              "const": "missing_field",
              "type": "string"
            },
            "field": {
              "$ref": "#/$defs/SpoolField",
              "description": "The field; for a correction naming neither figure, `remaining_g`,\nwhich `gross_g` may stand in for."
            }
          },
          "required": [
            "cause",
            "field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The command gave fields only one of which it may carry.",
          "properties": {
            "cause": {
              "const": "conflicting_fields",
              "type": "string"
            },
            "fields": {
              "description": "Every field given that conflicts, in the command's own order.",
              "items": {
                "$ref": "#/$defs/SpoolField"
              },
              "type": "array"
            }
          },
          "required": [
            "cause",
            "fields"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The command named a tool the printer cannot have.",
          "properties": {
            "cause": {
              "const": "unknown_tool",
              "type": "string"
            },
            "tool": {
              "description": "The tool named.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "cause",
            "tool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The spool is loaded on no tool, so there is nothing to unload.",
          "properties": {
            "cause": {
              "const": "not_loaded",
              "type": "string"
            },
            "spool_id": {
              "$ref": "#/$defs/SpoolId",
              "description": "The spool."
            }
          },
          "required": [
            "cause",
            "spool_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The ledger refused the write the command made, because the spools\nchanged under it; reading them again shows how.",
          "properties": {
            "cause": {
              "const": "ledger_refused",
              "type": "string"
            }
          },
          "required": [
            "cause"
          ],
          "type": "object"
        }
      ]
    },
    "Timestamp": {
      "description": "An instant in UTC, as an RFC 3339 string with a zero offset.",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "UnverifiedReason": {
      "description": "Why a spool's figure is in doubt.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A print ran on the spool's tool and nothing could be charged, because\nthe file had no analysis — an SD-card file, for one.",
          "properties": {
            "print_id": {
              "$ref": "#/$defs/PrintId",
              "description": "The print nothing could be charged for."
            },
            "reason": {
              "const": "uncharged_print",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "print_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A print this system never saw ran and did not complete.",
          "properties": {
            "file_name": {
              "description": "The file that was printed.",
              "type": "string"
            },
            "printed_at": {
              "$ref": "#/$defs/Timestamp",
              "description": "When it was printed."
            },
            "reason": {
              "const": "unaccounted_print",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "file_name",
            "printed_at"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A filament change was signalled and nobody has said which spool is now\nloaded. The spool was charged up to a position read when the signal was\nhandled.",
          "properties": {
            "print_id": {
              "$ref": "#/$defs/PrintId",
              "description": "The print the change was signalled during."
            },
            "reason": {
              "const": "filament_change_unconfirmed",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "print_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A filament change was signalled, nobody has said which spool is now\nloaded, and no fresh position could be read at the signal: the spool was\ncharged only up to the last recorded position, so its figure may be\noverstated.",
          "properties": {
            "print_id": {
              "$ref": "#/$defs/PrintId",
              "description": "The print the change was signalled during."
            },
            "reason": {
              "const": "filament_change_unconfirmed_position",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "print_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file's print tally was reset, and it cannot be told which of the\nprints since the re-upload were already settled.",
          "properties": {
            "file_name": {
              "description": "The file whose tally was reset.",
              "type": "string"
            },
            "origin": {
              "description": "Where the file lives, in the printer's own vocabulary.",
              "type": "string"
            },
            "reason": {
              "const": "tally_reset",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "file_name",
            "origin"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
