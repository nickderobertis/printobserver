{
  "$defs": {
    "MaterialObjection": {
      "description": "Why the material check objects to a start, with what it compared.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The file was sliced for another material than the loaded spool's.",
          "properties": {
            "cause": {
              "const": "mismatch",
              "type": "string"
            },
            "loaded": {
              "description": "That spool's material.",
              "type": "string"
            },
            "sliced_for": {
              "description": "The material the file's own `filament_type` names for the tool.",
              "type": "string"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool loaded on it."
            },
            "tool": {
              "description": "The tool, in the printer's own numbering.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "cause",
            "tool",
            "spool",
            "loaded",
            "sliced_for"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The file names no `filament_type`, so what it was sliced for is\nunknown.",
          "properties": {
            "cause": {
              "const": "undeclared",
              "type": "string"
            },
            "file_name": {
              "description": "The file that was to be compared.",
              "type": "string"
            },
            "loaded": {
              "description": "That spool's material.",
              "type": "string"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool loaded on it."
            },
            "tool": {
              "description": "The tool, in the printer's own numbering.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "cause",
            "tool",
            "spool",
            "loaded",
            "file_name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The file's settings could not be read from the printer.",
          "properties": {
            "cause": {
              "const": "unread",
              "type": "string"
            },
            "detail": {
              "description": "What the printer answered instead, in its own words.",
              "type": "string"
            },
            "file_name": {
              "description": "The file whose settings could not be read.",
              "type": "string"
            },
            "loaded": {
              "description": "That spool's material.",
              "type": "string"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool loaded on it."
            },
            "tool": {
              "description": "The tool, in the printer's own numbering.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "cause",
            "tool",
            "spool",
            "loaded",
            "file_name",
            "detail"
          ],
          "type": "object"
        }
      ]
    },
    "MaterialResult": {
      "description": "Whether a file was sliced for the material of the spool loaded on tool 0,\ntagged by its verdict.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The file was sliced for the loaded spool's material.",
          "properties": {
            "loaded": {
              "description": "That spool's material.",
              "type": "string"
            },
            "sliced_for": {
              "description": "The material the file's own `filament_type` names for the tool.",
              "type": "string"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool loaded on it."
            },
            "tool": {
              "description": "The tool, in the printer's own numbering.",
              "format": "int64",
              "type": "integer"
            },
            "verdict": {
              "const": "passed",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "tool",
            "spool",
            "loaded",
            "sliced_for"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No tracked spool is loaded on tool 0, or the check is off, so nothing\nwas compared.",
          "properties": {
            "verdict": {
              "const": "unchecked",
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The check refuses the start.",
          "properties": {
            "objection": {
              "$ref": "#/$defs/MaterialObjection",
              "description": "What it objected to."
            },
            "verdict": {
              "const": "refused",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "objection"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The start went ahead despite this objection, because an operator said\nso.",
          "properties": {
            "objection": {
              "$ref": "#/$defs/MaterialObjection",
              "description": "What it objected to."
            },
            "verdict": {
              "const": "overridden",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "objection"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The check is set to warn, and let the start go ahead despite this\nobjection.",
          "properties": {
            "objection": {
              "$ref": "#/$defs/MaterialObjection",
              "description": "What it objected to."
            },
            "verdict": {
              "const": "warned",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "objection"
          ],
          "type": "object"
        }
      ]
    },
    "PreflightNeed": {
      "additionalProperties": false,
      "description": "What a print needs from one spool, in grams: both figures a comparison\nwith what the spool holds uses, or neither.",
      "properties": {
        "buffer_g": {
          "description": "The margin asked for beyond that.",
          "format": "double",
          "type": "number"
        },
        "required_g": {
          "description": "What the print needs from the spool, by the file's analysis and the\nspool's own diameter and density.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "required_g",
        "buffer_g"
      ],
      "type": "object"
    },
    "PreflightObjection": {
      "description": "What a check that refuses a start found for one tool.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The spool holds less than the print needs and its buffer.",
          "properties": {
            "marks": {
              "description": "The spool's marks at the check, oldest first, so a spool both short\nand unverified says both.",
              "items": {
                "$ref": "#/$defs/UnverifiedMark"
              },
              "type": "array"
            },
            "need": {
              "$ref": "#/$defs/PreflightNeed",
              "description": "What the print needs from it."
            },
            "remaining_g": {
              "description": "What the spool holds, in grams.",
              "format": "double",
              "type": "number"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool."
            },
            "verdict": {
              "const": "insufficient",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "spool",
            "remaining_g",
            "need"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The spool's figure is in doubt.",
          "properties": {
            "marks": {
              "description": "Every reason the spool's figure is in doubt, oldest first; never empty.",
              "items": {
                "$ref": "#/$defs/UnverifiedMark"
              },
              "minItems": 1,
              "type": "array"
            },
            "need": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PreflightNeed"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the print needs from it, when the file's analysis says."
            },
            "remaining_g": {
              "description": "What the spool holds, in grams.",
              "format": "double",
              "type": "number"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool."
            },
            "verdict": {
              "const": "unverified_spool",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "spool",
            "remaining_g",
            "marks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The file has no analysis, so what the spool must hold is unknown.",
          "properties": {
            "remaining_g": {
              "description": "What the spool holds, in grams.",
              "format": "double",
              "type": "number"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool."
            },
            "verdict": {
              "const": "no_analysis",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "spool",
            "remaining_g"
          ],
          "type": "object"
        }
      ]
    },
    "PreflightSpool": {
      "additionalProperties": false,
      "description": "The spool a check judged, named beside its identifier so a reader need\nnot look it up.",
      "properties": {
        "id": {
          "$ref": "#/$defs/SpoolId",
          "description": "The spool's identifier."
        },
        "name": {
          "description": "The spool's name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "PreflightTool": {
      "additionalProperties": false,
      "description": "What a filament check found for one tool.",
      "properties": {
        "result": {
          "$ref": "#/$defs/PreflightToolResult",
          "description": "What the check found for it, with the evidence that finding rests on."
        },
        "tool": {
          "description": "The tool, in the printer's own numbering.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "tool",
        "result"
      ],
      "type": "object"
    },
    "PreflightToolResult": {
      "description": "What a filament check found for one tool, tagged by its verdict, each\nverdict carrying exactly the evidence it rests on.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The spool holds what the print needs and its buffer, and its figure is\nnot in doubt.",
          "properties": {
            "need": {
              "$ref": "#/$defs/PreflightNeed",
              "description": "What the print needs from it."
            },
            "remaining_g": {
              "description": "What the spool holds, in grams.",
              "format": "double",
              "type": "number"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool."
            },
            "verdict": {
              "const": "passed",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "spool",
            "remaining_g",
            "need"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No tracked spool is loaded on the tool, so nothing was checked.",
          "properties": {
            "verdict": {
              "const": "unchecked",
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The spool holds less than the print needs and its buffer.",
          "properties": {
            "marks": {
              "description": "The spool's marks at the check, oldest first, so a spool both short\nand unverified says both.",
              "items": {
                "$ref": "#/$defs/UnverifiedMark"
              },
              "type": "array"
            },
            "need": {
              "$ref": "#/$defs/PreflightNeed",
              "description": "What the print needs from it."
            },
            "remaining_g": {
              "description": "What the spool holds, in grams.",
              "format": "double",
              "type": "number"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool."
            },
            "verdict": {
              "const": "insufficient",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "spool",
            "remaining_g",
            "need"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The spool's figure is in doubt.",
          "properties": {
            "marks": {
              "description": "Every reason the spool's figure is in doubt, oldest first; never empty.",
              "items": {
                "$ref": "#/$defs/UnverifiedMark"
              },
              "minItems": 1,
              "type": "array"
            },
            "need": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PreflightNeed"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the print needs from it, when the file's analysis says."
            },
            "remaining_g": {
              "description": "What the spool holds, in grams.",
              "format": "double",
              "type": "number"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool."
            },
            "verdict": {
              "const": "unverified_spool",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "spool",
            "remaining_g",
            "marks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`OctoPrint`'s analysis of the file had not appeared, so what the spool\nmust hold is unknown.",
          "properties": {
            "remaining_g": {
              "description": "What the spool holds, in grams.",
              "format": "double",
              "type": "number"
            },
            "spool": {
              "$ref": "#/$defs/PreflightSpool",
              "description": "The spool."
            },
            "verdict": {
              "const": "no_analysis",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "spool",
            "remaining_g"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The start went ahead despite this objection, because an operator said\nso.",
          "properties": {
            "objection": {
              "$ref": "#/$defs/PreflightObjection",
              "description": "What the check objected to."
            },
            "verdict": {
              "const": "overridden",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "objection"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The check is set to warn, and let the start go ahead despite this\nobjection.",
          "properties": {
            "objection": {
              "$ref": "#/$defs/PreflightObjection",
              "description": "What the check objected to."
            },
            "verdict": {
              "const": "warned",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "objection"
          ],
          "type": "object"
        }
      ]
    },
    "PreflightVerdict": {
      "description": "What a filament check found, for one tool or for a whole print.",
      "oneOf": [
        {
          "const": "passed",
          "description": "The spool holds what the print needs and its buffer.",
          "type": "string"
        },
        {
          "const": "unchecked",
          "description": "No tracked spool is loaded on the tool, so nothing was checked.",
          "type": "string"
        },
        {
          "const": "insufficient",
          "description": "The spool holds less than the print needs and its buffer.",
          "type": "string"
        },
        {
          "const": "unverified_spool",
          "description": "The spool's figure is in doubt.",
          "type": "string"
        },
        {
          "const": "no_analysis",
          "description": "`OctoPrint`'s analysis of the file had still not appeared when the\nstart's wait for it elapsed, or has not appeared yet when the check is\nonly read.",
          "type": "string"
        },
        {
          "const": "overridden",
          "description": "The start went ahead despite the check, because the actor said so.",
          "type": "string"
        },
        {
          "const": "warned",
          "description": "The check is set to warn, and let an insufficient, unverified or\nunanalysed start go ahead.",
          "type": "string"
        }
      ]
    },
    "PrintId": {
      "description": "A lowercase hyphenated version 7 UUID identifying one print.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "PrintId",
      "type": "string"
    },
    "SheetObjection": {
      "description": "Why the sheet check objects to a start, with what it compared.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The table lists the material, and not on this sheet.",
          "properties": {
            "allowed": {
              "description": "Every sheet the table allows that material.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "cause": {
              "const": "not_allowed",
              "type": "string"
            },
            "material": {
              "description": "The material of the spool loaded on tool 0.",
              "type": "string"
            },
            "sheet": {
              "description": "The build sheet the manifest declares.",
              "type": "string"
            }
          },
          "required": [
            "cause",
            "sheet",
            "material",
            "allowed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The table has no entry for the material.",
          "properties": {
            "cause": {
              "const": "unlisted_material",
              "type": "string"
            },
            "material": {
              "description": "The material of the spool loaded on tool 0.",
              "type": "string"
            },
            "sheet": {
              "description": "The build sheet the manifest declares.",
              "type": "string"
            }
          },
          "required": [
            "cause",
            "sheet",
            "material"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No entry of the table lists the sheet.",
          "properties": {
            "cause": {
              "const": "unknown_sheet",
              "type": "string"
            },
            "known": {
              "description": "Every sheet some entry lists.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "material": {
              "description": "The material of the spool loaded on tool 0.",
              "type": "string"
            },
            "sheet": {
              "description": "The build sheet the manifest declares.",
              "type": "string"
            }
          },
          "required": [
            "cause",
            "sheet",
            "material",
            "known"
          ],
          "type": "object"
        }
      ]
    },
    "SheetResult": {
      "description": "Whether the declared build sheet suits the loaded spool's material, tagged\nby its verdict.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The table allows the material on the declared sheet.",
          "properties": {
            "allowed": {
              "description": "Every sheet the table allows that material.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "material": {
              "description": "The material of the spool loaded on tool 0.",
              "type": "string"
            },
            "sheet": {
              "description": "The build sheet the manifest declares.",
              "type": "string"
            },
            "verdict": {
              "const": "passed",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "sheet",
            "material",
            "allowed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No tracked spool is loaded on tool 0, or the check is off, so nothing\nwas compared.",
          "properties": {
            "verdict": {
              "const": "unchecked",
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The manifest declares no sheet. This refuses every start, and no\noverride lets it through.",
          "properties": {
            "verdict": {
              "const": "undeclared",
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The check refuses the start.",
          "properties": {
            "objection": {
              "$ref": "#/$defs/SheetObjection",
              "description": "What it objected to."
            },
            "verdict": {
              "const": "refused",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "objection"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The start went ahead despite this objection, because an operator said\nso.",
          "properties": {
            "objection": {
              "$ref": "#/$defs/SheetObjection",
              "description": "What it objected to."
            },
            "verdict": {
              "const": "overridden",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "objection"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The check is set to warn, and let the start go ahead despite this\nobjection.",
          "properties": {
            "objection": {
              "$ref": "#/$defs/SheetObjection",
              "description": "What it objected to."
            },
            "verdict": {
              "const": "warned",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "objection"
          ],
          "type": "object"
        }
      ]
    },
    "SpoolId": {
      "description": "A lowercase hyphenated version 7 UUID identifying one registered spool.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "SpoolId",
      "type": "string"
    },
    "Timestamp": {
      "description": "An instant in UTC, as an RFC 3339 string with a zero offset.",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "UnverifiedMark": {
      "additionalProperties": false,
      "description": "One reason a spool's figure is in doubt, and since when.",
      "properties": {
        "reason": {
          "$ref": "#/$defs/UnverifiedReason",
          "description": "Why the figure is in doubt."
        },
        "since": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the spool was marked for it."
        }
      },
      "required": [
        "reason",
        "since"
      ],
      "type": "object"
    },
    "UnverifiedReason": {
      "description": "Why a spool's figure is in doubt.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A print ran on the spool's tool and nothing could be charged, because\nthe file had no analysis — an SD-card file, for one.",
          "properties": {
            "print_id": {
              "$ref": "#/$defs/PrintId",
              "description": "The print nothing could be charged for."
            },
            "reason": {
              "const": "uncharged_print",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "print_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A print this system never saw ran and did not complete.",
          "properties": {
            "file_name": {
              "description": "The file that was printed.",
              "type": "string"
            },
            "printed_at": {
              "$ref": "#/$defs/Timestamp",
              "description": "When it was printed."
            },
            "reason": {
              "const": "unaccounted_print",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "file_name",
            "printed_at"
          ],
