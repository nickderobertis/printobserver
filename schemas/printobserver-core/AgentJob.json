{
  "$defs": {
    "ErrorSource": {
      "description": "Whose error a job's error is.",
      "oneOf": [
        {
          "const": "printer",
          "description": "The printer's own message: its firmware stopped the job.",
          "type": "string"
        },
        {
          "const": "host",
          "description": "The host's: it lost the line to the printer, or failed in itself.",
          "type": "string"
        }
      ]
    },
    "JobError": {
      "additionalProperties": false,
      "description": "A job's error, and whose it is.",
      "properties": {
        "source": {
          "$ref": "#/$defs/ErrorSource",
          "description": "Whose it is."
        },
        "text": {
          "description": "The error, as the source reported it.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source"
      ],
      "type": "object"
    },
    "PrinterState": {
      "description": "The state a source reports a printer or a print to be in.\n\nThe `unknown` arm exists so that a state nobody anticipated is recorded\ncarrying the source's own word for it rather than lost.",
      "oneOf": [
        {
          "const": "operational",
          "description": "Connected and idle.",
          "type": "string"
        },
        {
          "const": "paused",
          "description": "Printing, but paused.",
          "type": "string"
        },
        {
          "const": "printing",
          "description": "Printing.",
          "type": "string"
        },
        {
          "const": "cancelling",
          "description": "Cancelling a print.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "In an error state.",
          "type": "string"
        },
        {
          "const": "offline",
          "description": "Not reachable.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A state this vocabulary does not name, in the source's own word for it.",
          "properties": {
            "unknown": {
              "type": "string"
            }
          },
          "required": [
            "unknown"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The job as it is now.",
  "properties": {
    "completion": {
      "description": "How far through it is, from zero to one, when that was read in range.",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobError"
        },
        {
          "type": "null"
        }
      ],
      "description": "The error it stopped on, when it stopped on one."
    },
    "file_name": {
      "description": "The file it prints.",
      "type": [
        "string",
        "null"
      ]
    },
    "file_position_bytes": {
      "description": "How far into its file the printer has read, in bytes.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "print_time_s": {
      "description": "How long it has been printing, in seconds.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "state": {
      "$ref": "#/$defs/PrinterState",
      "description": "What the printer is doing with it."
    }
  },
  "required": [
    "state"
  ],
  "title": "AgentJob",
  "type": "object"
}
