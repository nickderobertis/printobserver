    "footprint": {
      "$ref": "#/$defs/Footprint",
      "description": "The XY rectangle of every extruding move."
    },
    "tallest_mm": {
      "description": "The highest Z an extruding move started or ended at, in millimetres.",
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "tallest_mm",
    "footprint"
  ],
  "title": "PrintedExtent",
  "type": "object"
}
