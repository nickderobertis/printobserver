{
  "name": "printobserver-sdk-python-integration",
  "root": "python/printobserver-sdk/integration",
  "projectType": "library",
  "tags": [
    "lang:python",
    "type:integration"
  ],
  "implicitDependencies": [
    "printobserver-sdk-python",
    "repo-checks"
  ],
  "targets": {
    "format": {
      "command": "uv run -q ruff format python/printobserver-sdk/integration"
    },
    "format-check": {
      "command": "uv run -q ruff format --check python/printobserver-sdk/integration"
    },
    "lint": {
      "command": "uv run -q ruff check python/printobserver-sdk/integration"
    },
    "typecheck": {
      "command": "uv run -q ty check --extra-search-path python/printobserver-sdk/integration python/printobserver-sdk/integration && uv run -q ty check --python-platform win32 --extra-search-path python/printobserver-sdk/integration python/printobserver-sdk/integration"
    },
    "test-integration": {
      "command": "uv run -q pytest python/printobserver-sdk/integration"
    }
  }
}
