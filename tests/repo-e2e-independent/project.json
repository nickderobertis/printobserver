{
  "name": "repo-e2e-independent",
  "root": "tests/repo-e2e-independent",
  "projectType": "library",
  "tags": ["lang:python", "type:e2e", "platform:independent"],
  "metadata": { "description": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge] suppressions.toml has the reason." },
  "implicitDependencies": ["github-workflows", "printobserver", "release-artifacts", "repo-checks", "repo-e2e"],
  "targets": {
    "format": { "command": "uv run -q ruff format tests/repo-e2e-independent" },
    "format-check": { "command": "uv run -q ruff format --check tests/repo-e2e-independent" },
    "lint": { "command": "uv run -q ruff check tests/repo-e2e-independent" },
    "typecheck": {
      "command": "uv run -q ty check tests/repo-e2e-independent && uv run -q ty check --python-platform win32 tests/repo-e2e-independent"
    },
    "test-e2e": { "metadata": { "description": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge, external_service_suite_stays_out_of_the_affected_tier] suppressions.toml has the reasons." },
      "command": "uv run -q pytest tests/repo-e2e-independent/tests -n auto --dist loadgroup --durations=15"
    }
  }
}
